{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "metadata", "dishes", "months", "rules"],
  "properties": {
    "version": { "type": "number" },
    "metadata": {
      "type": "object",
      "required": ["updatedAt", "tz"],
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" },
        "tz": { "type": "string", "enum": ["Europe/Madrid"] }
      }
    },
    "dishes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tags", "time", "ingredients"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "time": { "type": "number" },
          "ingredients": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "month", "plan"],
        "properties": {
          "year": { "type": "number" },
          "month": { "type": "number", "minimum": 1, "maximum": 12 },
          "plan": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["weekdaysOnly", "maxPerDay"],
      "properties": {
        "weekdaysOnly": { "type": "boolean" },
        "maxPerDay": { "type": "number" }
      }
    }
  }
}
